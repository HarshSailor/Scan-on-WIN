<Window x:Class="ScanOnWin.App.DonationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Помощь разработчику" Width="410" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Border Background="{DynamicResource PanelBackground}" Padding="24">
    <StackPanel>
      <TextBlock Text="Помощь разработчику" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Поддержать разработку Scan on WIN" TextWrapping="Wrap" Margin="0,12,0,24"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="DonateButton" Click="DonateClick"
                Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Пожертвовать"><TextBlock Text="Пожертвовать" Foreground="White"/></Button>
        <Button Content="Закрыть" IsCancel="True" Click="CloseClick" Margin="10,0,0,0"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
