<Window x:Class="ScanOnWin.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Scan on WIN" Width="1360" Height="900" MinWidth="1020" MinHeight="680" WindowStartupLocation="CenterScreen" Loaded="WindowLoaded" Closing="WindowClosing" SourceInitialized="WindowSourceInitialized">
  <Window.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/><KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}"/><KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/><KeyBinding Key="F5" Command="{Binding RefreshCommand}"/><KeyBinding Key="Escape" Command="{Binding CancelCommand}"/></Window.InputBindings>
  <Grid Background="{DynamicResource AppBackground}">
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="108"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Command="{Binding NewCommand}" Content="Новый документ" Margin="0,0,10,0" ToolTip="Очистить рабочую область (Ctrl+N)"/>
          <Button Command="{Binding ThemeCommand}" Content="◐  Тема" Margin="0,0,10,0" AutomationProperties.Name="Переключить тему"/>
          <Button Click="AboutClick" Content="О программе"/>
          <Button x:Name="DonationButton" Click="DonationClick" Background="#FFF0B3" Foreground="#172A34" Margin="10,0,0,0" Padding="10,7" FontSize="12" AutomationProperties.Name="Пожертвование"><TextBlock Text="Пожертвование" Foreground="#172A34"/></Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{DynamicResource AccentBrush}" Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0"><TextBlock Text="▤" Foreground="White" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel><TextBlock Text="Scan on WIN" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Ваши документы. На вашем компьютере." FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" Margin="18,18,18,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="282"/><ColumnDefinition Width="*" MinWidth="340"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
      <Border CornerRadius="12" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,10,18,18">
          <StackPanel>
            <TextBlock Text="Сканирование" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
            <TextBlock Text="УСТРОЙСТВО" Style="{StaticResource SectionLabel}"/>
            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="DisplayName" IsEnabled="{Binding UiEnabled}" ToolTip="Выберите устройство и интерфейс драйвера" AutomationProperties.Name="Сканер"/>
            <Button Command="{Binding RefreshCommand}" Content="↻  Обновить список устройств" Margin="0,8,0,0" FontSize="12"/>
            <TextBlock Text="{Binding DiscoveryNote}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
            <CheckBox Content="Открывать окно драйвера" IsChecked="{Binding NativeUi}" IsEnabled="{Binding NativeUiEnabled}" ToolTip="Для выбора дополнительных параметров в интерфейсе производителя"/>
            <StackPanel IsEnabled="{Binding ManualSettingsEnabled}">
              <TextBlock Text="ИСТОЧНИК БУМАГИ" Style="{StaticResource SectionLabel}"/>
              <ComboBox ItemsSource="{Binding Sources}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Source}" AutomationProperties.Name="Источник бумаги"/>
              <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="РАЗРЕШЕНИЕ" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/><ComboBox ItemsSource="{Binding DpiValues}" SelectedItem="{Binding Dpi}" AutomationProperties.Name="Разрешение DPI"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="ФОРМАТ ЛИСТА" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/><ComboBox ItemsSource="{Binding PageSizes}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding PageSize}" AutomationProperties.Name="Формат листа"/></StackPanel></Grid>
              <StackPanel Orientation="Horizontal" Visibility="{Binding IsCustomSize, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0"><TextBox Width="72" Text="{Binding CustomWidth}" AutomationProperties.Name="Ширина в мм"/><TextBlock Text=" × " VerticalAlignment="Center"/><TextBox Width="72" Text="{Binding CustomHeight}" AutomationProperties.Name="Высота в мм"/><TextBlock Text=" мм" VerticalAlignment="Center"/></StackPanel>
              <TextBlock Text="ЦВЕТОВОЙ РЕЖИМ" Style="{StaticResource SectionLabel}"/><ComboBox ItemsSource="{Binding Colors}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Color}" AutomationProperties.Name="Цветовой режим"/>
            </StackPanel>
            <TextBlock Text="{Binding CapabilitiesNote}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <CheckBox IsChecked="{Binding AutoDeskew}" Content="Автоматически выравнивать" IsEnabled="{Binding UiEnabled}" ToolTip="Выравнивать небольшой перекос при сканировании"/>
            <Button Command="{Binding PreviewCommand}" Content="Предварительный просмотр" Margin="0,6,0,0" ToolTip="Сканировать со стекла на низком DPI. Результат добавится в документ."/>
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,18,0,16"/>
            <TextBlock Text="Сохранение" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="ФОРМАТ ФАЙЛА" Style="{StaticResource SectionLabel}"/>
            <ComboBox x:Name="SaveFormatComboBox" ItemsSource="{Binding Formats}" SelectedItem="{Binding Format, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChooseSaveFormat}" IsEditable="False" IsSynchronizedWithCurrentItem="False" MaxDropDownHeight="200" AutomationProperties.Name="Формат сохранения"/>
            <StackPanel IsEnabled="{Binding UiEnabled}">
              <CheckBox Content="Сжимать изображения в PDF" IsChecked="{Binding CompressPdf}" ToolTip="При выключенном сжатии PDF сохраняет изображения без потерь"/>
              <Grid IsEnabled="{Binding QualityEnabled}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Качество JPG / сжатого PDF" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><Slider Minimum="1" Maximum="100" Value="{Binding Quality}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0" AutomationProperties.Name="Качество изображения"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Quality, StringFormat={}{0}%}" VerticalAlignment="Bottom" HorizontalAlignment="Right"/></Grid>
              <StackPanel IsEnabled="{Binding OcrSettingsEnabled}"><CheckBox IsChecked="{Binding Ocr}" Content="Распознавать текст (OCR)" ToolTip="Добавить невидимый текстовый слой в PDF. TXT всегда распознаётся."/><ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Language}" AutomationProperties.Name="Язык OCR"/></StackPanel>
              <TextBlock Text="ИМЯ ДОКУМЕНТА" Style="{StaticResource SectionLabel}"/><TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Имя документа"/>
              <TextBlock Text="ПАПКА СОХРАНЕНИЯ" Style="{StaticResource SectionLabel}"/><TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding OutputFolder}" AutomationProperties.Name="Папка сохранения"/><Button Command="{Binding BrowseCommand}" Content="Выбрать папку…" Margin="0,6,0,0"/>
              <CheckBox Content="Открыть папку после сохранения" IsChecked="{Binding OpenFolder}"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid Grid.Column="1" Margin="14,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
          <WrapPanel>
            <Button Command="{Binding RotateLeftCommand}" Content="↶" ToolTip="Повернуть на 270°" Margin="0,0,4,0"/>
            <Button Command="{Binding RotateRightCommand}" Content="↷" ToolTip="Повернуть на 90°" Margin="0,0,4,0"/>
            <Button Command="{Binding Rotate180Command}" Content="180°" ToolTip="Повернуть на 180°" Margin="0,0,4,0"/>
            <Button x:Name="CropButton" Click="CropClick" Content="Обрезать" IsEnabled="{Binding CanEdit}" Margin="0,0,4,0"/>
            <Button Command="{Binding UndoCommand}" Content="Отменить правку" ToolTip="Отменить последнюю правку (Ctrl+Z)" Margin="0,0,8,0"/>
            <Button Command="{Binding ZoomOutCommand}" Content="−" ToolTip="Уменьшить"/>
            <Button Command="{Binding FitCommand}" Content="{Binding ZoomLabel}" ToolTip="Вписать в окно" Margin="4,0"/>
            <Button Command="{Binding ZoomInCommand}" Content="+" ToolTip="Увеличить"/>
          </WrapPanel>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource PreviewBackground}" CornerRadius="10" Margin="0,10" ClipToBounds="True">
          <Grid>
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30"><TextBlock Text="▤" FontSize="72" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock Text="Здесь появится ваш документ" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10"/><TextBlock Text="Выберите сканер, положите оригинал&#10;и нажмите «Сканировать»." TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" LineHeight="22" TextWrapping="Wrap"/></StackPanel>
            <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="PreviewSizeChanged" Visibility="{Binding HasPage, Converter={StaticResource BoolToVisibility}}" Padding="24">
              <Grid x:Name="PreviewSurface" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="PreviewImage" Source="{Binding PreviewImage}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Canvas x:Name="CropCanvas" Background="Transparent" MouseLeftButtonDown="CropStart" MouseMove="CropMove" MouseLeftButtonUp="CropEnd" IsHitTestVisible="False" ClipToBounds="True"><Rectangle x:Name="CropRectangle" Stroke="#0F9D8C" StrokeThickness="2" Fill="#300F9D8C" Visibility="Collapsed"/></Canvas>
              </Grid>
            </ScrollViewer>
            <Border x:Name="CropHint" Visibility="Collapsed" Background="{DynamicResource PanelBackground}" CornerRadius="8" Padding="12" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12"><StackPanel Orientation="Horizontal"><TextBlock Text="Выделите область мышью" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="ApplyCropButton" Click="ApplyCropClick" Content="Применить" Style="{StaticResource PrimaryButton}" IsEnabled="False"/><Button Click="CancelCropClick" Content="×" Margin="6,0,0,0" ToolTip="Отменить обрезку"/></StackPanel></Border>
          </Grid>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <StackPanel><TextBlock Text="{Binding DocumentInfo}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,10"/><Grid IsEnabled="{Binding CanEdit}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Яркость" FontSize="11"/><Slider Minimum="-100" Maximum="100" Value="{Binding Brightness}" AutomationProperties.Name="Яркость"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Контрастность" FontSize="11"/><Slider Minimum="-100" Maximum="100" Value="{Binding Contrast}" AutomationProperties.Name="Контрастность"/></StackPanel><Button Grid.Column="3" Command="{Binding AdjustCommand}" Content="Применить" Margin="12,0,0,0"/></Grid></StackPanel>
        </Border>
      </Grid>
      <Border Grid.Column="2" Background="{DynamicResource PanelBackground}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="4,5,4,12"><TextBlock Text="Страницы" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Перетащите, чтобы переместить" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
          <ListBox Grid.Row="1" x:Name="PagesList" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True" PreviewMouseLeftButtonDown="PageDragStart" PreviewMouseMove="PageDragMove" Drop="PageDrop" IsEnabled="{Binding UiEnabled}" AutomationProperties.Name="Страницы документа">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><StackPanel><Border Background="White" Padding="3" HorizontalAlignment="Center"><Image Source="{Binding Thumbnail}" Width="116" Height="146" Stretch="Uniform"/></Border><TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Margin="0,7,0,2"/><TextBlock Text="{Binding Details}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2" Margin="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Command="{Binding MoveUpCommand}" Content="↑" Margin="0,0,3,0" ToolTip="Переместить выше"/><Button Grid.Column="1" Command="{Binding MoveDownCommand}" Content="↓" Margin="3,0,0,0" ToolTip="Переместить ниже"/></Grid><Button Command="{Binding DeleteCommand}" Content="Удалить страницу" Margin="0,6,0,0"/><Button Command="{Binding ScanCommand}" Content="+ Добавить страницы" Margin="0,6,0,0" ToolTip="Сканировать и добавить страницы к текущему документу"/></StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
      <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button Command="{Binding ScanCommand}" Content="Сканировать" Style="{StaticResource PrimaryButton}" FontSize="16" Width="190" Height="44" AutomationProperties.Name="Сканировать"/>
        <Button Grid.Column="1" Command="{Binding SaveCommand}" Content="Сохранить" FontSize="15" Width="150" Height="44" Margin="12,0,0,0"/>
        <Button x:Name="PrintButton" Grid.Column="2" Command="{Binding PrintCommand}" Content="Печать" FontSize="15" Width="110" Height="44" Margin="12,0,0,0" AutomationProperties.Name="Печать"/>
        <Button Grid.Column="3" Command="{Binding CancelCommand}" Content="Отмена" Height="44" Margin="12,0,0,0"/>
        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="24,0,0,0"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" MaxHeight="34" ToolTip="{Binding Status}"/><ProgressBar Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Height="4" Margin="0,8,0,0" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource PreviewBackground}" BorderThickness="0"/></StackPanel>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Text="Локальная работа · Без регистрации · Страницы автоматически восстанавливаются после перезапуска" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/>
      </Grid>
    </Border>
  </Grid>
</Window>
